# Neon Auth — Neon Console → your project → Auth → Configuration
NEON_AUTH_BASE_URL="https://<your-neon-auth-endpoint>/neondb/auth"
# Random 32+ char string used to sign session cookies (e.g. `openssl rand -base64 32`)
NEON_AUTH_COOKIE_SECRET="replace-with-a-long-random-string"

# Postgres connection string — Neon Console → Connect
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
